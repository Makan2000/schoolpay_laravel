APP_ENV=production
APP_DEBUG=false
APP_URL=https://schoolpay.example.com
FRONTEND_URL=https://schoolpay.example.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolpay
DB_USERNAME=schoolpay
DB_PASSWORD=change-me

MAIL_MAILER=smtp
