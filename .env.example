APP_NAME=SchoolPay
APP_ENV=local
APP_KEY=
# Garder APP_DEBUG=false par défaut. Passer à true uniquement en local.
APP_DEBUG=false
# Adapter à votre fuseau horaire si nécessaire (ex: Africa/Porto-Novo).
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
# URL publique du frontend utilisée dans les emails (réinitialisation et vérification).
# Laisser identique à APP_URL si le frontend et l'API sont servis ensemble.
FRONTEND_URL=http://localhost:8000
# Durée de validité des liens de vérification d'email, en minutes.
AUTH_VERIFICATION_EXPIRE=60

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite convient au développement local. Utiliser MySQL/PostgreSQL en production.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Durée de vie des tokens API, en minutes (10080 = 7 jours).
SANCTUM_TOKEN_EXPIRATION=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Relances d'échéances : fenêtre avant échéance, délai minimal entre deux
# relances d'une même facture et heure d'envoi quotidien.
RELANCE_JOURS_AVANT=7
RELANCE_COOLDOWN_JOURS=7
RELANCE_HEURE=08:00

# Journal d'audit : durée de rétention en jours (minimum 30) et taille
# maximale du payload expurgé conservé par entrée.
AUDIT_RETENTION_JOURS=365
AUDIT_PAYLOAD_MAX_OCTETS=8192

# Téléphone et OTP : indicatif par défaut et longueur des numéros locaux.
# Le numéro est converti en E.164 lors de la vérification.
TELEPHONE_INDICATIF=+223
TELEPHONE_LONGUEUR_MIN=8
TELEPHONE_LONGUEUR_MAX=9
OTP_LONGUEUR=6
OTP_VALIDITE_MINUTES=10
OTP_MAX_TENTATIVES=5
OTP_COOLDOWN_SECONDES=60
OTP_PURGE_JOURS=7

# SMS : log en local, textbelt (1 SMS gratuit par jour avec la clé "textbelt")
# ou twilio (compte d'essai avec destinataires vérifiés).
# En production, SMS_DRIVER=log est refusé : configurez un fournisseur réel.
SMS_DRIVER=log
SMS_TIMEOUT=10
TEXTBELT_KEY=textbelt
TEXTBELT_URL=https://textbelt.com/text
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Paiements en ligne : simulation en local, cinetpay en production.
# Le pilote simulation ne débite rien et ne doit jamais être activé en production.
PAYMENT_DRIVER=simulation
PAYMENT_DEVISE=XOF
PAYMENT_PAYS=ML
PAYMENT_MONTANT_MIN=1000
PAYMENT_MONTANT_MAX=2500000
PAYMENT_VERIFICATION_COOLDOWN=10
# URLs publiques appelées par CinetPay. Elles doivent être accessibles en HTTPS
# en production et ne pas dépasser 120 caractères.
PAYMENT_RETOUR_URL=
PAYMENT_WEBHOOK_URL=
PAYMENT_SIMULATION_DUREE_MINUTES=60

# CinetPay API v1 : clés fournies par le tableau de bord marchand.
# Sandbox : https://panel.cinetpay.net (clés sk_test_...)
# Production : clés sk_live_...
# Ne jamais coller ces valeurs dans le chat ni les versionner.
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_ENVIRONNEMENT=sandbox
# Laisser vide pour utiliser l'URL officielle selon l'environnement.
CINETPAY_BASE_URL=
CINETPAY_PAYS=ML
CINETPAY_DEVISE=XOF
CINETPAY_TIMEOUT=15
CINETPAY_CONNECT_TIMEOUT=5
# Facultatif : PUSH, OTP ou QRCODE si votre compte l'exige.
CINETPAY_CANAL=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En local, les emails sont écrits dans les logs. Configurer un vrai SMTP en production.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@schoolpay.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
